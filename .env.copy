# Wallet
PRIVATE_KEY=

# Connection
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
PRIVATE_RPC_ENDPOINT=
PRIVATE_RPC_WEBSOCKET_ENDPOINT=
SHYFT_GRAPHQL_API_URL=https://programs.shyft.to/v0/graphql/?network=mainnet-beta&api_key= # specify your API key here
COMMITMENT_LEVEL=confirmed
DISABLE_RETRY_ON_RATE_LIMIT=false

# Bot
LOG_LEVEL=trace
ONE_TOKEN_AT_A_TIME=true
PRE_LOAD_EXISTING_MARKETS=false # if true, PRIVATE_RPC_ENDPOINT must be set, because getProgramAccounts RPC call is used
CACHE_NEW_MARKETS=false
# default or warp or jito or tpu
TRANSACTION_EXECUTOR=default
# if using default executor, fee below will be applied
COMPUTE_UNIT_LIMIT=101337
COMPUTE_UNIT_PRICE=421197
# if using warp or jito executor, fee below will be applied
CUSTOM_FEE=0.006

# Wallet server
WALLET_SERVER_PORT=8000
NODE_ENV=development # production, development or test

# Buy
QUOTE_MINT=WSOL
QUOTE_AMOUNT=0.001
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=10
BUY_SLIPPAGE=20
BUY_SKIP_PREFLIGHT=false

# Sell
AUTO_SELL=true
MAX_SELL_RETRIES=10
AUTO_SELL_DELAY=0
PRICE_CHECK_INTERVAL=2000
PRICE_CHECK_DURATION=600000
TAKE_PROFIT=40
STOP_LOSS=20
SELL_SLIPPAGE=20
SELL_SKIP_PREFLIGHT=false

# Filters
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000
FILTER_CHECK_DURATION=60000
FILTER_CHECK_INTERVAL=2000
CONSECUTIVE_FILTER_MATCHES=3
CHECK_IF_MUTABLE=false
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=false
CHECK_IF_BURNED=true
MIN_POOL_SIZE=5
MAX_POOL_SIZE=50
